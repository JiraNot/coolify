# Environment Variables for onetapweb_t3
# คัดลอกส่วนนี้ไปใส่ใน .env.local ของโปรเจกต์ onetapweb_t3

# ── Coolify Integration ────────────────────────────────────────────────────

# URL ของ Coolify instance (ไม่มี trailing slash)
COOLIFY_BASE_URL=https://your-coolify.onetapweb.com

# Personal Access Token จาก Coolify
# วิธีสร้าง: Coolify Dashboard > Security > API Tokens > Create Token
# Permissions ที่ต้องเลือก: read, write, deploy
COOLIFY_API_TOKEN=

# Secret Key สำหรับ Webhook (ตั้งอะไรก็ได้ที่ยาวและสุ่ม)
# ใช้ generate: openssl rand -hex 32
COOLIFY_WEBHOOK_SECRET=

# UUID ของ Server หลัก (ดูได้จาก Coolify > Servers > เลือก Server > ดู URL)
# ตัวอย่าง: e3b0c442-98fc-1c14-9afb-f4c8996fb924
COOLIFY_SERVER_UUID=

# UUID ของ Docker Network/Destination สำหรับ Deploy (ดูจาก Servers > Destinations)
COOLIFY_DESTINATION_UUID=
